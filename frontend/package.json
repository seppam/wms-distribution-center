{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:demo": "playwright test -c playwright.demo.config.js",
    "dev:browser-demo": "vite --mode browser-demo",
    "build:browser-demo": "vite build --mode browser-demo && node scripts/postbuild-browser-demo.mjs",
    "preview:browser-demo": "vite preview --mode browser-demo --outDir dist-browser-demo --port 5176 --strictPort",
    "typecheck": "tsc -p tsconfig.json",
    "check:bundle": "node scripts/check-bundle.mjs",
    "test:e2e:browser-demo": "playwright test -c playwright.browser-demo.config.js"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.3",
    "axios": "^1.20.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.18.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.17.0",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^30.1.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.12",
    "vitest": "^5.0.4"
  }
}
