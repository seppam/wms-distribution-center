# Copy to .env (git-ignored) and replace every value marked CHANGE. Used by docker-compose.yml.
# Use letters and digits for the database password (it is embedded in a connection string).
POSTGRES_DB=wms_dc
POSTGRES_USER=wms_admin
POSTGRES_PASSWORD=change-me-db-password
# Random signing key, at least 32 characters, e.g.: openssl rand -base64 48
JWT_KEY=change-me-random-signing-key-at-least-32-chars
# First administrator, created only when the database has no users. At least 12 characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password
# Set to true to also load a fictional warehouse with products and stock (no demo accounts are created).
SEED_DEMO_DATA=false
# Host ports
WEB_PORT=5174
API_PORT=5301
DB_PORT=5333
